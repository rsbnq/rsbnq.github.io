---
import { siWhatsapp, siInstagram, siFacebook, siYoutube, siGooglemaps } from 'simple-icons';

export type IconName = 'whatsapp' | 'phone' | 'mail' | 'instagram' | 'facebook' | 'youtube' | 'map' | 'link';

interface Props {
  name: IconName;
  size?: number;
}

const paths: Record<IconName, string> = {
  whatsapp: siWhatsapp.path,
  instagram: siInstagram.path,
  facebook: siFacebook.path,
  youtube: siYoutube.path,
  map: siGooglemaps.path,
  phone:
    'M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8Z',
  mail: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2.4V17h16V7.4l-8 5.6-8-5.6ZM5.6 7 12 11.5 18.4 7H5.6Z',
  link: 'M10.6 13.4a1 1 0 0 1 0-1.4l3.5-3.5a1 1 0 1 1 1.4 1.4L12 13.4a1 1 0 0 1-1.4 0ZM7.8 19.1a3.9 3.9 0 0 1-2.8-6.7l2.5-2.5a1 1 0 1 1 1.4 1.4l-2.5 2.5a1.9 1.9 0 0 0 2.7 2.7l2.5-2.5a1 1 0 1 1 1.4 1.4l-2.5 2.5a3.9 3.9 0 0 1-2.7 1.2Zm7.3-5.6a1 1 0 0 1-.7-1.7l2.5-2.5a1.9 1.9 0 1 0-2.7-2.7l-2.5 2.5a1 1 0 1 1-1.4-1.4l2.5-2.5a3.9 3.9 0 0 1 5.5 5.5l-2.5 2.5a1 1 0 0 1-.7.3Z',
};

const { name, size = 20 } = Astro.props;
---

<svg class="icon" viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" fill="currentColor">
  <path d={paths[name]}></path>
</svg>
